{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": [],
  "permissions": {
    "allow": [
      "Read(./docs/**)",
      "Read(./.claude/**)",
      "Bash(pdfinfo *)",
      "Bash(pdftotext *)",
      "Bash(pdfimages *)",
      "Bash(python3 -m unittest *)",
      "Bash(bean-check *)",
      "Bash(bean-query *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.envrc.local)",
      "Edit(./.envrc.local)",
      "Bash(secret reveal *)",
      "Bash(secret exec *)",
      "Bash(secret copy *)",
      "Bash(secret set *)",
      "mcp__claude_ai_Google_Drive__share_file"
    ]
  }
}
