# direnv: this repo's per-operator settings, scoped to this directory.
# Run `direnv allow` once. Values never live here — see .envrc.local below.

# Operator values first, so the dev shell's hook already sees them.
source_env_if_exists .envrc.local

use flake

dotenv_if_exists .env

# Per-operator, gitignored file pointing at the finance folder (CLAUDE.md § Where the data lives):
#   export LEDGER_DRIVE_DIR="$HOME/Library/CloudStorage/GoogleDrive-<account>/My Drive/<finance folder>"
